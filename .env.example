# Admin uses the sign-in page only. Legacy Basic credentials are not supported.
ADMIN_EMAILS=natinael.96@gmail.com
BETTER_AUTH_URL=
BETTER_AUTH_SECRET=
# Pooled runtime URL, supplied by the Neon Vercel integration.
DATABASE_URL=
# Direct connection for reviewed migrations only.
DATABASE_URL_UNPOOLED=
# Local development only. npm run local:setup configures this safely.
# Never enabled in production; requires a dedicated loopback database.
LOCAL_AUTH_SETUP=0

# Connect a PRIVATE Vercel Blob store. Keep credentials server-side.
BLOB_READ_WRITE_TOKEN=
# Alternatively, a connected store can use Vercel's OIDC credentials.
BLOB_STORE_ID=

# A long random secret for the daily cleanup endpoint.
CRON_SECRET=

# Optional local development only; never used on Vercel.
# STORAGE_DRIVER=local
# LOCAL_STORAGE_DIR=.local-storage

# Set to postgres to keep catalogue, posts, history and proforma JSON in Neon.
# Images continue to use STORAGE_DRIVER (local development or private Blob).
# CONTENT_STORAGE_DRIVER=postgres
# Optional separate CMS branch; otherwise DATABASE_URL is used.
# CMS_DATABASE_URL=
# CMS_DATABASE_URL_UNPOOLED=
