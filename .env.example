# Production accounts are provisioned privately with auth:create-admin.
# Pooled runtime URL, supplied by the Neon Vercel integration.
DATABASE_URL=
# Direct connection for reviewed migrations only.
DATABASE_URL_UNPOOLED=
# Connect a PRIVATE Vercel Blob store. Keep credentials server-side.
BLOB_READ_WRITE_TOKEN=
# Alternatively, a connected store can use Vercel's OIDC credentials.
BLOB_STORE_ID=

# A long random secret for the daily cleanup endpoint.
CRON_SECRET=

# Optional local development only; never used on Vercel.
# STORAGE_DRIVER=local
# LOCAL_STORAGE_DIR=.local-storage

# Set to postgres to keep catalogue, posts, proforma drafts and enquiries in Neon.
# Images continue to use STORAGE_DRIVER (local development or private Blob).
# CONTENT_STORAGE_DRIVER=postgres
# Optional separate CMS database for local preview only. Production uses DATABASE_URL.
# CMS_DATABASE_URL=
# CMS_DATABASE_URL_UNPOOLED=

# Resend API key for the enquiry forms. Without it the forms report that the
# message could not be sent and offer the phone and WhatsApp numbers instead.
RESEND_API_KEY=

# Sender address. Resend only accepts a verified domain; until stemedicaet.com
# has DNS, leave this unset to use onboarding@resend.dev, which delivers only
# to the address that owns the API key.
# ENQUIRY_FROM=STEM MEDICA <enquiries@stemedicaet.com>

# Where enquiries are delivered. Defaults to the address in src/lib/site.ts.
# ENQUIRY_TO=
